{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File / Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "purpose": [
                "debug-test"
            ],
            "justMyCode": false,
            "env": {
                // The monitoring backend skips project files named io.py.
                "PYDEVD_USE_SYS_MONITORING": "0"
            }
        }
    ]
}
